# LBBS San Juan — production finishing template for the surveyed hEX.
# RouterOS v7.23.8, WAN ether1, admin ether2-4, HotSpot on bridge-hotspot/ether5.
# Upload the final portal to flash/hotspot and lbbs-sync.rsc + lbbs-heartbeat.rsc to flash/.
# Replace ONLY {{LBBS_ROUTER_TOKEN}} after creating/regenerating the router in /control/wifi.

:global lbbsApiBaseUrl "https://app.labajaditabarberstudio.com"
:global lbbsRouterToken "{{LBBS_ROUTER_TOKEN}}"
:global lbbsHotspotServerName "lbbs-hotspot"
:global lbbsHotspotUserProfile "lbbs-client-profile"

:local serverId [/ip hotspot find where name="lbbs-hotspot"]
:if ([:len $serverId] = 0) do={ :error "LBBS: lbbs-hotspot no existe" }
/ip hotspot set $serverId interface=bridge-hotspot address-pool=pool-hotspot profile=lbbs-hotspot-profile idle-timeout=none keepalive-timeout=3m login-timeout=5m addresses-per-mac=1 disabled=no

:local serverProfileId [/ip hotspot profile find where name="lbbs-hotspot-profile"]
:if ([:len $serverProfileId] = 0) do={ :error "LBBS: lbbs-hotspot-profile no existe" }
/ip hotspot profile set $serverProfileId hotspot-address=10.10.10.1 dns-name="wifi.lbbs.test" login-by=http-chap,mac-cookie html-directory=hotspot use-radius=no

# HotSpot hook variables only exist inside on-login/on-logout, so the lifecycle code
# is stored directly in the user profile instead of calling another /system script.
:local onLoginSource ":global lbbsApiBaseUrl;:global lbbsRouterToken;:local lbbsUser \$user;:local lbbsMac \$\"mac-address\";:local lbbsIp \$address;:local lbbsUserId [/ip hotspot user find where name=\$lbbsUser];:if ([:len \$lbbsUserId] > 0) do={:local lbbsTag [/ip hotspot user get \$lbbsUserId comment];:if ([:pick \$lbbsTag 0 5] = \"LBBS:\") do={:local lbbsVoucherId [:pick \$lbbsTag 5 [:len \$lbbsTag]];:local lbbsPayload {\"voucherId\"=\$lbbsVoucherId;\"mac\"=\$lbbsMac;\"ip\"=\$lbbsIp;\"event\"=\"LOGIN\";\"metadata\"={\"router\"=\"RouterOS\"}};:do {/tool fetch url=(\$lbbsApiBaseUrl . \"/api/wifi/router/session\") http-method=post http-header-field=(\"Content-Type: application/json,Authorization: Bearer \" . \$lbbsRouterToken) http-data=[:serialize to=json value=\$lbbsPayload] check-certificate=yes output=none} on-error={:log warning \"LBBS: LOGIN no enviado\"}}}}"
:local onLogoutSource ":global lbbsApiBaseUrl;:global lbbsRouterToken;:local lbbsUser \$user;:local lbbsMac \$\"mac-address\";:local lbbsIp \$address;:local lbbsCause \$cause;:local lbbsUserId [/ip hotspot user find where name=\$lbbsUser];:if ([:len \$lbbsUserId] > 0) do={:local lbbsTag [/ip hotspot user get \$lbbsUserId comment];:if ([:pick \$lbbsTag 0 5] = \"LBBS:\") do={:local lbbsVoucherId [:pick \$lbbsTag 5 [:len \$lbbsTag]];/ip hotspot cookie remove [find where mac-address=\$lbbsMac];/ip hotspot user remove \$lbbsUserId;:local lbbsPayload {\"voucherId\"=\$lbbsVoucherId;\"mac\"=\$lbbsMac;\"ip\"=\$lbbsIp;\"event\"=\"LOGOUT\";\"metadata\"={\"reason\"=\$lbbsCause}};:do {/tool fetch url=(\$lbbsApiBaseUrl . \"/api/wifi/router/session\") http-method=post http-header-field=(\"Content-Type: application/json,Authorization: Bearer \" . \$lbbsRouterToken) http-data=[:serialize to=json value=\$lbbsPayload] check-certificate=yes output=none} on-error={:log warning \"LBBS: LOGOUT no enviado; acceso invalidado localmente\"}}}}"

:local userProfileId [/ip hotspot user profile find where name="lbbs-client-profile"]
:if ([:len $userProfileId] = 0) do={ :error "LBBS: lbbs-client-profile no existe" }
/ip hotspot user profile set $userProfileId shared-users=1 idle-timeout=none keepalive-timeout=3m session-timeout=3h add-mac-cookie=yes mac-cookie-timeout=3h on-login=$onLoginSource on-logout=$onLogoutSource

# Remove the manual test credential before production use.
/ip hotspot active remove [find where user="654321"]
/ip hotspot cookie remove [find where user="654321"]
/ip hotspot user remove [find where comment="TEMP LBBS TEST"]

# Pre-auth access is limited to the LBBS API and legal site.
:if ([:len [/ip hotspot walled-garden find where dst-host="app.labajaditabarberstudio.com"]] = 0) do={
  /ip hotspot walled-garden add dst-host="app.labajaditabarberstudio.com" action=allow comment="LBBS captive API"
}
:if ([:len [/ip hotspot walled-garden find where dst-host="web.labajaditabarberstudio.com"]] = 0) do={
  /ip hotspot walled-garden add dst-host="web.labajaditabarberstudio.com" action=allow comment="LBBS legal pages"
}

# The .rsc files install/update persistent /system script entries.
/import file-name=flash/lbbs-sync.rsc
/import file-name=flash/lbbs-heartbeat.rsc

/system scheduler remove [find where name="lbbs-sync"]
/system scheduler remove [find where name="lbbs-heartbeat"]
/system scheduler add name="lbbs-sync" interval=5s on-event="lbbs-sync" policy=ftp,read,write,policy,test,sensitive comment="LBBS command pull"
/system scheduler add name="lbbs-heartbeat" interval=30s on-event="lbbs-heartbeat" policy=ftp,read,write,policy,test,sensitive comment="LBBS router heartbeat"

# Manual smoke checks after import:
# /system script run lbbs-heartbeat
# /system script run lbbs-sync
# /system scheduler print
# /ip hotspot walled-garden print
# /environment print
