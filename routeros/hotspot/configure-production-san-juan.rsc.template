# LBBS San Juan — production finishing template for the already-surveyed hEX.
# RouterOS v7.23.8, WAN ether1, admin ether2-4, HotSpot on bridge-hotspot/ether5.
# Upload portal files to flash/hotspot and the four LBBS scripts to Files before importing.
# Replace ONLY {{LBBS_ROUTER_TOKEN}} after creating the router in /control/wifi.

:global LBBS_API_BASE_URL "https://app.labajaditabarberstudio.com"
:global LBBS_ROUTER_TOKEN "{{LBBS_ROUTER_TOKEN}}"
:global LBBS_HOTSPOT_SERVER_NAME "lbbs-hotspot"
:global LBBS_HOTSPOT_USER_PROFILE "lbbs-client-profile"

:local serverId [/ip hotspot find where name="lbbs-hotspot"]
:if ([:len $serverId] = 0) do={ :error "LBBS: lbbs-hotspot no existe" }
/ip hotspot set $serverId interface=bridge-hotspot address-pool=pool-hotspot profile=lbbs-hotspot-profile idle-timeout=none keepalive-timeout=3m login-timeout=5m addresses-per-mac=1 disabled=no

:local serverProfileId [/ip hotspot profile find where name="lbbs-hotspot-profile"]
:if ([:len $serverProfileId] = 0) do={ :error "LBBS: lbbs-hotspot-profile no existe" }
/ip hotspot profile set $serverProfileId hotspot-address=10.10.10.1 dns-name="wifi.lbbs.test" login-by=http-chap,mac-cookie html-directory=hotspot use-radius=no

:local userProfileId [/ip hotspot user profile find where name="lbbs-client-profile"]
:if ([:len $userProfileId] = 0) do={ :error "LBBS: lbbs-client-profile no existe" }
/ip hotspot user profile set $userProfileId shared-users=1 idle-timeout=none keepalive-timeout=3m session-timeout=3h add-mac-cookie=yes mac-cookie-timeout=3h on-login="/system script run lbbs-session-login" on-logout="/system script run lbbs-session-logout"

# Remove the manual test credential before production use.
/ip hotspot active remove [find where user="654321"]
/ip hotspot cookie remove [find where user="654321"]
/ip hotspot user remove [find where comment="TEMP LBBS TEST"]

# Pre-auth access is limited to the LBBS API and legal site.
:if ([:len [/ip hotspot walled-garden find where dst-host="app.labajaditabarberstudio.com"]] = 0) do={
  /ip hotspot walled-garden add dst-host="app.labajaditabarberstudio.com" action=allow comment="LBBS captive API"
}
:if ([:len [/ip hotspot walled-garden find where dst-host="web.labajaditabarberstudio.com"]] = 0) do={
  /ip hotspot walled-garden add dst-host="web.labajaditabarberstudio.com" action=allow comment="LBBS legal pages"
}

# Import/update runtime scripts. Re-importing a script file is safe after removing the old script.
/system script remove [find where name="lbbs-sync"]
/system script remove [find where name="lbbs-heartbeat"]
/system script remove [find where name="lbbs-session-login"]
/system script remove [find where name="lbbs-session-logout"]
/import file-name=lbbs-sync.rsc
/import file-name=lbbs-heartbeat.rsc
/import file-name=lbbs-session-login.rsc
/import file-name=lbbs-session-logout.rsc

/system scheduler remove [find where name="lbbs-sync"]
/system scheduler remove [find where name="lbbs-heartbeat"]
/system scheduler add name="lbbs-sync" interval=5s on-event="/system script run lbbs-sync" comment="LBBS command pull"
/system scheduler add name="lbbs-heartbeat" interval=30s on-event="/system script run lbbs-heartbeat" comment="LBBS router heartbeat"

# Manual smoke checks after import:
# /system script run lbbs-heartbeat
# /system script run lbbs-sync
# /system scheduler print
# /ip hotspot walled-garden print
